{
  "name": "korvir/wp-migrations",
  "description": "Simple migration runner for WordPress",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "WPMigrations\\": "src/"
    },
    "files": [
      "src/bootstrap.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WPMigrations\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-cli/wp-cli": "^2.12"
  },
  "scripts": {
    "test": "phpunit"
  }
}
